# ===================================================================
# Application Environment Variables Template (.env.example)
# ===================================================================

# Server Port
PORT=8080

# Spring Boot Datasource (Supabase PostgreSQL / External DB)
SPRING_DATASOURCE_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=<DATABASE_PASSWORD>

# Standard PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@<SUPABASE_HOST>:5432/postgres

# Supabase API & Project Configuration
SUPABASE_PROJECT_REF=<PROJECT_REF>
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<ANON_KEY>

# Docker Image
DOCKER_IMAGE=russellsahoo24/temporal:latest
